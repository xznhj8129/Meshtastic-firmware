# Local PX4-Autopilot checkout. The harness uses the existing incremental build state.
PX4_DIR="/path/to/PX4-Autopilot"

# USB-UART adapter wired to the air node UART.
# Prefer by-id when serial values are unique; use by-path when adapters collide.
AIR_UART="/dev/serial/by-path/REPLACE_WITH_YOUR_USB_UART"

# Reachable Wi-Fi address or hostname of the UDP Meshtastic node.
GROUND_HOST="REPLACE_WITH_GROUND_NODE"

# Must match the air node serial module configuration.
AIR_BAUD=57600

# Fixed probe destinations. Probe transmission does not wait for or depend on received traffic.
TARGET_SYSID=1
TARGET_COMPID=1

# The ground node listens on remote UDP 14550. The recorder binds local UDP 14600.
GROUND_PORT=14550
LOCAL_PORT=14600

# PX4 serial link profile.
MAX_RATE_BPS=1000
BUILD_TIMEOUT=1200

# Raw capture schedule. Each cycle sends REQUEST_MESSAGE, then SET_MESSAGE_INTERVAL after
# CONTROL_OFFSET_SECONDS. Nothing is gated on heartbeat, telemetry, a response, or an ACK.
WARMUP_SECONDS=5
PROBE_ATTEMPTS=10
PROBE_INTERVAL_SECONDS=3
CONTROL_OFFSET_SECONDS=1
DRAIN_SECONDS=8

REPORT_ROOT="mavlink_tests/reports"
