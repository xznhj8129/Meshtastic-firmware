# PX4 source checkout. This is the user's previously used local path; change it if needed.
PX4_DIR="/media/anon/WD2TB/DataVault/TechProjects/Software/other_software/PX4-Autopilot"

# Stable /dev/serial/by-id path for the USB-UART adapter wired to the air node UART.
AIR_UART="/dev/serial/by-id/usb-REPLACE_WITH_YOUR_USB_UART"

# Wi-Fi address of the UDP-only ground Meshtastic node.
GROUND_HOST="192.168.0.232"

# Must match the air node serial module configuration.
AIR_BAUD=115200

# PX4 SIH instance 0 uses MAVLink sysid 1.
EXPECTED_SYSID=1

# Ground node listens on 14550. The verifier binds 14600 so PX4's ordinary QGC path cannot satisfy the test.
GROUND_PORT=14550
LOCAL_PORT=14600

# Deliberately austere first profile: HEARTBEAT 1 Hz + HIGH_LATENCY2 0.5 Hz.
MAX_RATE_BPS=1000

BUILD_TIMEOUT=1200
TEST_TIMEOUT=240
COMMAND_ATTEMPTS=3
REPORT_ROOT="mavlink_tests/reports"
