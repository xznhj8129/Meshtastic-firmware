# Local PX4-Autopilot checkout. Incremental `make` is used; the harness does not clean it.
PX4_DIR="/path/to/PX4-Autopilot"

# USB-UART adapter wired to the air node UART.
# Prefer by-id when serial values are unique; use by-path when adapters collide.
AIR_UART="/dev/serial/by-path/REPLACE_WITH_YOUR_USB_UART"

# Reachable Wi-Fi address or hostname of the UDP-only ground Meshtastic node.
GROUND_HOST="REPLACE_WITH_GROUND_NODE"

# Must match the air node serial module configuration. The first hardware run used 57600.
AIR_BAUD=57600

# PX4 SIH instance 0 uses MAVLink sysid 1.
EXPECTED_SYSID=1

# The ground node listens on remote UDP 14550. The verifier binds local UDP 14600.
GROUND_PORT=14550
LOCAL_PORT=14600

# Deliberately austere profile: HEARTBEAT 1 Hz + HIGH_LATENCY2 0.5 Hz.
MAX_RATE_BPS=1000

# A normal cached PX4 tree starts quickly. BUILD_TIMEOUT only covers a legitimate first build.
BUILD_TIMEOUT=1200
TEST_TIMEOUT=120
COMMAND_ATTEMPTS=3
ACK_GRACE=25
REPORT_ROOT="mavlink_tests/reports"
